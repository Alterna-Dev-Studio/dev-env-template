#!/usr/bin/env python3
"""Launch the local Taiga MCP server with SOPS credentials from one scope.

The pytaiga-mcp checkout defaults to ~/work/utils/pytaiga-mcp; set
PYTAIGA_MCP_HOME to use another location. scripts/setup-taiga-mcp creates it.
"""
import os
from pathlib import Path
import runpy
import sys


def main():
    if len(sys.argv) not in (2, 3) or sys.argv[1] not in ("workflow", "full"):
        raise RuntimeError("usage: taiga-mcp workflow|full [profile|project/NAME]")
    scope = sys.argv[2] if len(sys.argv) == 3 else "profile"

    root = Path(__file__).resolve().parent.parent
    server_root = Path(os.environ.get("PYTAIGA_MCP_HOME") or Path.home() / "work/utils/pytaiga-mcp")
    python = server_root / ".venv/bin/python"
    server = server_root / "src" / f"server_{sys.argv[1]}.py"
    if not python.is_file() or not server.is_file():
        raise RuntimeError(f"Install pytaiga-mcp and its virtual environment at {server_root} (run scripts/setup-taiga-mcp)")

    profile = runpy.run_path(str(root / "scripts/envtool"))["decrypt"](scope)
    required = ("TAIGA_API_URL", "TAIGA_USERNAME", "TAIGA_PASSWORD")
    missing = [name for name in required if not profile.get(name)]
    if missing:
        raise RuntimeError(f"Missing encrypted Taiga settings in {scope}: " + ", ".join(missing))

    # The checkout has a legacy .env. Explicit environment values take precedence
    # over it, including empty values for Pangolin settings absent from SOPS.
    names = required + (
        "PANGOLIN_RESOURCE_TOKEN", "PANGOLIN_ACCESS_TOKEN_ID",
        "PANGOLIN_ACCESS_TOKEN", "PANGOLIN_SESSION_REQUEST_PARAM",
    )
    for name in names:
        os.environ[name] = profile.get(name, "")
    os.environ["TAIGA_TRANSPORT"] = "stdio"
    os.chdir(server_root)
    os.execv(str(python), [str(python), str(server)])


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, OSError, ValueError) as error:
        print(f"taiga-mcp: {error}", file=sys.stderr)
        sys.exit(1)
