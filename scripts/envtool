#!/usr/bin/env python3
"""Manage SOPS-encrypted environment variables without plaintext files."""
import argparse
import getpass
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent
# Same lookup order SOPS uses on Linux.
KEY_FILE = Path(os.environ.get("SOPS_AGE_KEY_FILE")
                or Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
                / "sops/age/keys.txt")
CONFIG = ROOT / ".sops.yaml"
NAME = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
SCOPE = re.compile(r"^(profile|project/[A-Za-z0-9_-]+)$")
SCOPE_HELP = "profile or project/<name>"


def locate(name):
    """Path of a tool on PATH or in ~/go/bin, or None when it is not installed."""
    found = shutil.which(name) or str(Path.home() / "go/bin" / name)
    return found if Path(found).is_file() else None


def binary(name):
    found = locate(name)
    if found is None:
        raise RuntimeError(f"{name} is required; see README.md")
    return found


def run(args, *, data=None):
    result = subprocess.run(args, input=data, text=True, capture_output=True, cwd=ROOT)
    if result.returncode:
        raise RuntimeError(f"{Path(args[0]).name} failed: {result.stderr.strip()}")
    return result.stdout


def require_identity():
    if not os.environ.get("SOPS_AGE_KEY") and not KEY_FILE.is_file():
        raise RuntimeError(f"No age identity at {KEY_FILE}; restore it before using the vault")


def identities():
    """Public keys for every identity in the local key file."""
    require_identity()
    keys = run([binary("age-keygen"), "-y", str(KEY_FILE)]).split()
    if not keys:
        raise RuntimeError(f"No age identity found in {KEY_FILE}")
    return keys


def recipients():
    """Age recipients named by .sops.yaml creation rules."""
    found = re.findall(r"(?m)^\s*age:\s*(\S.*?)\s*$", CONFIG.read_text())
    return [key.strip() for line in found for key in line.split(",") if key.strip()]


def path_for(scope):
    if not SCOPE.fullmatch(scope):
        raise RuntimeError("Scope must be profile or project/<name>")
    return ROOT / "secrets" / f"{scope}.enc.json"


def encrypt(scope, values):
    target = path_for(scope)
    target.parent.mkdir(parents=True, exist_ok=True)
    payload = json.dumps(values, sort_keys=True, indent=2) + "\n"
    if not CONFIG.exists():
        raise RuntimeError("Missing .sops.yaml; run ./scripts/setup first")
    # Recipients come from .sops.yaml, never from whichever local key is first.
    encrypted = run([binary("sops"), "encrypt",
                     "--input-type", "json", "--output-type", "json",
                     "--filename-override", str(target.relative_to(ROOT))], data=payload)
    fd, temporary = tempfile.mkstemp(prefix=".encrypted-", dir=target.parent)
    try:
        with os.fdopen(fd, "w") as output:
            output.write(encrypted)
        os.replace(temporary, target)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def decrypt(scope):
    target = path_for(scope)
    if not target.exists():
        return {}
    require_identity()
    payload = run([binary("sops"), "decrypt", "--input-type", "json",
                   "--output-type", "json", str(target)])
    data = json.loads(payload)
    if not isinstance(data, dict) or any(not NAME.fullmatch(k) or not isinstance(v, str)
                                         for k, v in data.items()):
        raise RuntimeError("Vault must contain string environment variables")
    return data


def initialize():
    binary("sops")
    keygen = binary("age-keygen")
    if CONFIG.exists() and not KEY_FILE.exists():
        raise RuntimeError(f"Restore the age identity to {KEY_FILE} before setup")
    if not KEY_FILE.exists():
        KEY_FILE.parent.mkdir(parents=True, exist_ok=True)
        KEY_FILE.parent.chmod(0o700)
        try:
            run([keygen, "-o", str(KEY_FILE)])
        except Exception:
            KEY_FILE.unlink(missing_ok=True)
            raise
    KEY_FILE.chmod(0o600)
    local = identities()
    if CONFIG.exists():
        if not set(local) & set(recipients()):
            raise RuntimeError(f"No identity in {KEY_FILE} matches a .sops.yaml recipient; "
                               "restore this vault's age identity")
    else:
        CONFIG.write_text("creation_rules:\n"
                          "  - path_regex: secrets/.*\\.enc\\.json$\n"
                          f"    age: {local[0]}\n")
    if not path_for("profile").exists():
        encrypt("profile", {})
    decrypt("profile")
    print(f"Initialized SOPS for {ROOT}.")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True, metavar="COMMAND")
    init_text = "create the age identity, .sops.yaml, and an empty profile (called by setup)"
    sub.add_parser("init", help=init_text, description=init_text)
    for command, text in (("export", "print `export NAME=value` lines for a scope "
                                     "(used by profile.sh and .envrc)"),
                          ("list", "print the variable names stored in a scope, never the values"),
                          ("edit", "open the decrypted scope as JSON in $EDITOR via sops")):
        sub.add_parser(command, help=text, description=text).add_argument("scope", help=SCOPE_HELP)
    set_text = "store one variable in a scope; the value is read with hidden input"
    setting = sub.add_parser("set", help=set_text, description=set_text)
    setting.add_argument("scope", help=SCOPE_HELP)
    setting.add_argument("name", help="environment variable name, e.g. TAIGA_PASSWORD")
    args = parser.parse_args()
    if args.command == "init":
        initialize()
    elif args.command == "set":
        if not NAME.fullmatch(args.name):
            raise RuntimeError("Invalid environment variable name")
        values = decrypt(args.scope)
        values[args.name] = getpass.getpass(f"{args.name}: ")
        encrypt(args.scope, values)
        print(f"Saved {args.name} in {args.scope}.")
    elif args.command == "edit":
        target = path_for(args.scope)
        if not target.exists():
            encrypt(args.scope, {})
        require_identity()
        subprocess.run([binary("sops"), str(target)], check=True)
    else:
        values = decrypt(args.scope)
        if args.command == "list":
            for name in sorted(values):
                print(name)
        else:
            for name, value in sorted(values.items()):
                print(f"export {name}={shlex.quote(value)}")


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, OSError, ValueError, subprocess.CalledProcessError) as error:
        print(f"envtool: {error}", file=sys.stderr)
        sys.exit(1)
