#!/usr/bin/env python3
"""Initialize SOPS and install the shared profile in Bash."""
import argparse
import os
from pathlib import Path
import re
import runpy
import shlex
import tempfile

ROOT = Path(__file__).resolve().parent.parent
tool = runpy.run_path(str(ROOT / "scripts/envtool"))
SHARED = (
    "TAIGA_API_URL", "TAIGA_HOST", "TAIGA_USERNAME", "TAIGA_PASSWORD",
    "GH_TOKEN", "GH_TOKEN_FOR_PACKAGES", "GH_TOKEN_FOR_CHECKS",
    "OPENROUTER_API_KEY",
)
SOURCE = f"[ -f {shlex.quote(str(ROOT / 'profile.sh'))} ] && source {shlex.quote(str(ROOT / 'profile.sh'))}\n"
BASHRC = Path.home() / ".bashrc"


def rewrite_bashrc(remove_existing):
    old = BASHRC.read_text() if BASHRC.exists() else ""
    lines = old.splitlines(keepends=True)
    if remove_existing:
        pattern = re.compile(r"^\s*export (?:" + "|".join(SHARED) + r")=")
        lines = [line for line in lines if not pattern.match(line)]
    lines = [line for line in lines if "source " + shlex.quote(str(ROOT / "profile.sh")) not in line
             and line != "# Shared development tooling environment (managed by dev-env setup).\n"]
    insertion = next((index for index, line in enumerate(lines)
                      if "# Keep direnv last" in line), len(lines))
    lines.insert(insertion, "# Shared development tooling environment (managed by dev-env setup).\n")
    lines.insert(insertion + 1, SOURCE)
    result = "".join(lines)
    if result == old:
        return
    fd, temporary = tempfile.mkstemp(prefix=".bashrc-dev-env-", dir=BASHRC.parent)
    try:
        with os.fdopen(fd, "w") as output:
            output.write(result)
        os.chmod(temporary, BASHRC.stat().st_mode & 0o777 if BASHRC.exists() else 0o644)
        os.replace(temporary, BASHRC)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--migrate-bashrc", action="store_true",
                        help="encrypt current shared exports, then remove plaintext exports")
    args = parser.parse_args()
    tool["initialize"]()
    if args.migrate_bashrc:
        existing = BASHRC.read_text()
        present = [name for name in SHARED if re.search(rf"(?m)^\s*export {name}=", existing)]
        missing = [name for name in present if name not in os.environ]
        if missing:
            raise RuntimeError("Current shell lacks these .bashrc variables: " + ", ".join(missing))
        profile = tool["decrypt"]("profile")
        profile.update({name: os.environ[name] for name in present})
        tool["encrypt"]("profile", profile)
        check = tool["decrypt"]("profile")
        if any(check[name] != os.environ[name] for name in present):
            raise RuntimeError("Encrypted profile verification failed; .bashrc was not changed")
        rewrite_bashrc(True)
        print(f"Migrated {len(present)} shared variables and updated ~/.bashrc.")
    else:
        rewrite_bashrc(False)
        print("Updated ~/.bashrc to source the encrypted profile.")


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, OSError) as error:
        print(f"setup: {error}", file=__import__("sys").stderr)
        raise SystemExit(1)
