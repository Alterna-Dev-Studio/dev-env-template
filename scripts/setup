#!/usr/bin/env python3
"""Initialize SOPS and install the shared profile in Bash."""
import argparse
import getpass
import os
from pathlib import Path
import re
import runpy
import shlex
import shutil
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent
tool = runpy.run_path(str(ROOT / "scripts/envtool"))


def load_shared(path=ROOT / "shared-variables.txt"):
    """Return the variable names listed one per line; '#' comments and blank lines are ignored."""
    names = []
    for line in path.read_text().splitlines():
        line = line.split("#", 1)[0].strip()
        if line:
            if not re.fullmatch(r"[A-Z_][A-Z0-9_]*", line):
                raise RuntimeError(f"{path.name}: invalid variable name {line!r}")
            names.append(line)
    if not names:
        raise RuntimeError(f"{path.name} lists no variable names")
    return tuple(names)


SOURCE = f"[ -f {shlex.quote(str(ROOT / 'profile.sh'))} ] && source {shlex.quote(str(ROOT / 'profile.sh'))}\n"
BASHRC = Path.home() / ".bashrc"
LOGINRC = next((Path.home() / name for name in (".bash_profile", ".bash_login")
                if (Path.home() / name).exists()), Path.home() / ".profile")
LOGIN_SOURCE = (f'if [ -n "${{BASH_VERSION:-}}" ] && [ -f {shlex.quote(str(ROOT / "profile.sh"))} ]; '
                f'then . {shlex.quote(str(ROOT / "profile.sh"))}; fi\n')
COMMENT = "# Shared development tooling environment (managed by dev-env setup).\n"
DIRENV = ["# Keep direnv last (managed by dev-env setup).\n", 'eval "$(direnv hook bash)"\n']


def rewrite_bashrc(remove_existing):
    old = BASHRC.read_text() if BASHRC.exists() else ""
    lines = old.splitlines(keepends=True)
    if remove_existing:
        pattern = re.compile(r"^\s*export (?:" + "|".join(SHARED) + r")=")
        lines = [line for line in lines if not pattern.match(line)]
    lines = [line for line in lines if "source " + shlex.quote(str(ROOT / "profile.sh")) not in line
             and line != COMMENT]
    if lines and not lines[-1].endswith("\n"):
        lines[-1] += "\n"
    # Project .envrc files need the direnv hook, and it must run after the profile loads.
    hook = next((index for index, line in enumerate(lines)
                 if "# Keep direnv last" in line
                 or re.search(r"\bdirenv\s+(?:export|hook)\s+bash\b", line)), None)
    if hook is None:
        lines += [COMMENT, SOURCE] + (DIRENV if shutil.which("direnv") else [])
    else:
        lines[hook:hook] = [COMMENT, SOURCE]
    result = "".join(lines)
    if result == old:
        return
    fd, temporary = tempfile.mkstemp(prefix=".bashrc-dev-env-", dir=BASHRC.parent)
    try:
        with os.fdopen(fd, "w") as output:
            output.write(result)
        os.chmod(temporary, BASHRC.stat().st_mode & 0o777 if BASHRC.exists() else 0o644)
        os.replace(temporary, BASHRC)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def rewrite_loginrc():
    old = LOGINRC.read_text() if LOGINRC.exists() else ""
    if LOGIN_SOURCE in old:
        return
    result = old.rstrip("\n") + "\n\n# Development tooling profile (managed by dev-env setup).\n" + LOGIN_SOURCE
    fd, temporary = tempfile.mkstemp(prefix=f"{LOGINRC.name}-dev-env-", dir=LOGINRC.parent)
    try:
        with os.fdopen(fd, "w") as output:
            output.write(result)
        os.chmod(temporary, LOGINRC.stat().st_mode & 0o777 if LOGINRC.exists() else 0o644)
        os.replace(temporary, LOGINRC)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--migrate-bashrc", action="store_true",
                        help="encrypt current shared exports, then remove plaintext exports")
    parser.add_argument("--add-keys", action="store_true",
                        help="prompt for shared credentials with hidden input")
    args = parser.parse_args()
    if args.add_keys and not sys.stdin.isatty():
        raise RuntimeError("--add-keys requires an interactive terminal")
    tool["initialize"]()
    if args.add_keys:
        profile = tool["decrypt"]("profile")
        print("Enter shared tool values; leave blank to keep an existing value or skip.")
        updated = []
        for name in SHARED:
            value = getpass.getpass(f"{name}: ")
            if value:
                profile[name] = value
                updated.append(name)
        if updated:
            tool["encrypt"]("profile", profile)
            check = tool["decrypt"]("profile")
            if any(check[name] != profile[name] for name in updated):
                raise RuntimeError("Encrypted profile verification failed")
            print(f"Saved {len(updated)} shared values.")
    if args.migrate_bashrc:
        existing = BASHRC.read_text()
        present = [name for name in SHARED if re.search(rf"(?m)^\s*export {name}=", existing)]
        missing = [name for name in present if name not in os.environ]
        if missing:
            raise RuntimeError("Current shell lacks these .bashrc variables: " + ", ".join(missing))
        profile = tool["decrypt"]("profile")
        profile.update({name: os.environ[name] for name in present})
        tool["encrypt"]("profile", profile)
        check = tool["decrypt"]("profile")
        if any(check[name] != os.environ[name] for name in present):
            raise RuntimeError("Encrypted profile verification failed; .bashrc was not changed")
        rewrite_bashrc(True)
        rewrite_loginrc()
        print(f"Migrated {len(present)} shared variables and updated ~/.bashrc and {LOGINRC}.")
    else:
        rewrite_bashrc(False)
        rewrite_loginrc()
        print(f"Updated ~/.bashrc and {LOGINRC} to source the development profile.")


if __name__ == "__main__":
    try:
        SHARED = load_shared()
        main()
    except (RuntimeError, OSError) as error:
        print(f"setup: {error}", file=__import__("sys").stderr)
        raise SystemExit(1)
