#!/usr/bin/env python3
"""Initialize SOPS and install the shared profile in Bash."""
import argparse
import getpass
import os
from pathlib import Path
import re
import runpy
import shlex
import shutil
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent
tool = runpy.run_path(str(ROOT / "scripts/envtool"))


# The repository's own Taiga helpers and MCP launcher cannot run without these.
REQUIRED = ("TAIGA_API_URL", "TAIGA_USERNAME", "TAIGA_PASSWORD")
# One install hint per required tool; README.md § Setup has the long form.
TOOLS = {
    "sops": "install the .deb from https://github.com/getsops/sops/releases, "
            "or: go install github.com/getsops/sops/v3/cmd/sops@latest",
    "age-keygen": "sudo apt install age, or: go install filippo.io/age/cmd/age-keygen@latest",
    "direnv": "sudo apt install direnv",
}
SOURCE = f"[ -f {shlex.quote(str(ROOT / 'profile.sh'))} ] && source {shlex.quote(str(ROOT / 'profile.sh'))}\n"
BASHRC = Path.home() / ".bashrc"
LOGINRC = next((Path.home() / name for name in (".bash_profile", ".bash_login")
                if (Path.home() / name).exists()), Path.home() / ".profile")
LOGIN_SOURCE = (f'if [ -n "${{BASH_VERSION:-}}" ] && [ -f {shlex.quote(str(ROOT / "profile.sh"))} ]; '
                f'then . {shlex.quote(str(ROOT / "profile.sh"))}; fi\n')
COMMENT = "# Shared development tooling environment (managed by dev-env setup).\n"
DIRENV = ["# Keep direnv last (managed by dev-env setup).\n", 'eval "$(direnv hook bash)"\n']


def rewrite_bashrc(remove_names=()):
    old = BASHRC.read_text() if BASHRC.exists() else ""
    lines = old.splitlines(keepends=True)
    if remove_names:
        pattern = re.compile(r"^\s*export (?:" + "|".join(remove_names) + r")=")
        lines = [line for line in lines if not pattern.match(line)]
    lines = [line for line in lines if "source " + shlex.quote(str(ROOT / "profile.sh")) not in line
             and line != COMMENT]
    if lines and not lines[-1].endswith("\n"):
        lines[-1] += "\n"
    # Project .envrc files need the direnv hook, and it must run after the profile loads.
    hook = next((index for index, line in enumerate(lines)
                 if "# Keep direnv last" in line
                 or re.search(r"\bdirenv\s+(?:export|hook)\s+bash\b", line)), None)
    if hook is None:
        lines += [COMMENT, SOURCE] + (DIRENV if shutil.which("direnv") else [])
    else:
        lines[hook:hook] = [COMMENT, SOURCE]
    result = "".join(lines)
    if result == old:
        return
    fd, temporary = tempfile.mkstemp(prefix=".bashrc-dev-env-", dir=BASHRC.parent)
    try:
        with os.fdopen(fd, "w") as output:
            output.write(result)
        os.chmod(temporary, BASHRC.stat().st_mode & 0o777 if BASHRC.exists() else 0o644)
        os.replace(temporary, BASHRC)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def rewrite_loginrc():
    old = LOGINRC.read_text() if LOGINRC.exists() else ""
    if LOGIN_SOURCE in old:
        return
    result = old.rstrip("\n") + "\n\n# Development tooling profile (managed by dev-env setup).\n" + LOGIN_SOURCE
    fd, temporary = tempfile.mkstemp(prefix=f"{LOGINRC.name}-dev-env-", dir=LOGINRC.parent)
    try:
        with os.fdopen(fd, "w") as output:
            output.write(result)
        os.chmod(temporary, LOGINRC.stat().st_mode & 0o777 if LOGINRC.exists() else 0o644)
        os.replace(temporary, LOGINRC)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def preflight():
    missing = [name for name in TOOLS if tool["locate"](name) is None]
    if missing:
        raise RuntimeError("missing required tools:\n"
                           + "\n".join(f"  {name}: {TOOLS[name]}" for name in missing))


def prompt_missing():
    """Collect required profile values on a terminal; only name them otherwise."""
    stored = tool["decrypt"]("profile")
    missing = [name for name in REQUIRED if not stored.get(name)]
    if not missing:
        return
    hint = "Add each with ./scripts/envtool set profile NAME."
    if not sys.stdin.isatty():
        print("Missing required profile values: " + ", ".join(missing) + ". " + hint)
        return
    print("Enter the required profile values (input is hidden; leave one blank to skip it).")
    entered = {name: value for name in missing if (value := getpass.getpass(f"{name}: "))}
    if entered:
        stored.update(entered)
        tool["encrypt"]("profile", stored)
        check = tool["decrypt"]("profile")
        if any(check.get(name) != value for name, value in entered.items()):
            raise RuntimeError("Encrypted profile verification failed")
        print("Saved " + ", ".join(sorted(entered)) + " in profile.")
    skipped = [name for name in missing if name not in entered]
    if skipped:
        print("Still missing: " + ", ".join(skipped) + ". " + hint)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--migrate-bashrc", nargs="+", metavar="NAME", default=[],
                        help="encrypt these exports from the current shell, then remove them from ~/.bashrc")
    args = parser.parse_args()
    for name in args.migrate_bashrc:
        if not re.fullmatch(r"[A-Z_][A-Z0-9_]*", name):
            raise RuntimeError(f"invalid variable name {name!r}")
    preflight()
    tool["initialize"]()
    if args.migrate_bashrc:
        existing = BASHRC.read_text() if BASHRC.exists() else ""
        absent = [name for name in args.migrate_bashrc
                  if not re.search(rf"(?m)^\s*export {name}=", existing)]
        if absent:
            raise RuntimeError("~/.bashrc does not export: " + ", ".join(absent))
        missing = [name for name in args.migrate_bashrc if name not in os.environ]
        if missing:
            raise RuntimeError("Current shell lacks these .bashrc variables: " + ", ".join(missing))
        profile = tool["decrypt"]("profile")
        profile.update({name: os.environ[name] for name in args.migrate_bashrc})
        tool["encrypt"]("profile", profile)
        check = tool["decrypt"]("profile")
        if any(check[name] != os.environ[name] for name in args.migrate_bashrc):
            raise RuntimeError("Encrypted profile verification failed; .bashrc was not changed")
        rewrite_bashrc(args.migrate_bashrc)
        rewrite_loginrc()
        print(f"Migrated {len(args.migrate_bashrc)} variables and updated ~/.bashrc and {LOGINRC}.")
    else:
        rewrite_bashrc()
        rewrite_loginrc()
        print(f"Updated ~/.bashrc and {LOGINRC} to source the development profile.")
    prompt_missing()

if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, OSError) as error:
        print(f"setup: {error}", file=sys.stderr)
        raise SystemExit(1)
