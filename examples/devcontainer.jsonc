{
  // Merge these entries into a project's .devcontainer/devcontainer.json.
  "initializeCommand": "bash -c 'mkdir -p \"${HOME}/.claude\" \"${HOME}/.codex\"; touch \"${HOME}/.claude.json\"'",
  "mounts": [
    "source=${localEnv:HOME}/work/utils/jon-dev-env/shell,target=/opt/dev-env-shell,type=bind,readonly",
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind",
    "source=${localEnv:HOME}/.claude.json,target=/home/vscode/.claude.json,type=bind",
    "source=${localEnv:HOME}/.codex,target=/home/vscode/.codex,type=bind"
  ],
  "postCreateCommand": "bash /opt/dev-env-shell/install-container.sh",
  "containerEnv": {
    "TAIGA_API_URL": "${localEnv:TAIGA_API_URL}",
    "TAIGA_USERNAME": "${localEnv:TAIGA_USERNAME}",
    "TAIGA_PASSWORD": "${localEnv:TAIGA_PASSWORD}",
    "GH_TOKEN": "${localEnv:GH_TOKEN}",
    "GH_TOKEN_FOR_PACKAGES": "${localEnv:GH_TOKEN_FOR_PACKAGES}"
  }
}
